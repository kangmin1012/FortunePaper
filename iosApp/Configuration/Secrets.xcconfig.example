// 이 파일을 복사해 Secrets.xcconfig 로 만들고 실제 값을 채운다.
//   cp Secrets.xcconfig.example Secrets.xcconfig
// 모두 앱 코드에서 직접 쓰는 키이므로 .claude/rules/secrets.md 기준 앱-사이드 저장 대상이다.
// SUPABASE_URL의 `//`는 xcconfig 주석으로 오인되므로 `/$()/` 트릭으로 이스케이프한다.
SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_PUBLISHABLE_KEY
